<?xml version="1.0" encoding="UTF-8"?>
<MEProEQPreset name="Kick and Bass Separation" category="Bass" author="ME Audio" version="1" description="Insert on the bass. Route the kick to ME Pro EQ's sidechain input: the 60 Hz band dips the bass only while the kick hits (external sidechain).">
