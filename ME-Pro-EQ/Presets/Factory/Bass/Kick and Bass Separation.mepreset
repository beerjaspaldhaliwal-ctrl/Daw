  <PARAM id="b1_q" value="0.7071"/>
  <PARAM id="b1_slope" value="2"/>
  <PARAM id="b1_stereo" value="0"/>
  <PARAM id="b2_used" value="1"/>
  <PARAM id="b2_on" value="1"/>
  <PARAM id="b2_type" value="0"/>
  <PARAM id="b2_freq" value="60"/>
  <PARAM id="b2_gain" value="0"/>
  <PARAM id="b2_q" value="2"/>
  <PARAM id="b2_slope" value="1"/>
  <PARAM id="b2_stereo" value="0"/>
  <PARAM id="b2_dyn" value="1"/>
  <PARAM id="b2_thr" value="-24"/>
  <PARAM id="b2_ratio" value="4"/>
  <PARAM id="b2_att" value="2"/>
  <PARAM id="b2_rel" value="90"/>
